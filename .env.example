# ── Swasthya-Neeti — Environment Variables ──
# Copy this file to .env and fill in your values.

# MongoDB connection string (MongoDB Atlas cloud)
MONGO_URI="mongodb+srv://USER:PASSWORD@HOST/DATABASE_NAME?retryWrites=true&w=majority"

# Gemini (used when set; takes priority over Groq for chat, translate, PDF graph)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Groq API key and model (still required for voice transcription)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="groq/compound-mini"

# Server port (local development only — ignored on Vercel)
PORT=3001

# Frontend API base URL (leave empty for Vercel — only needed for custom setups)
# VITE_API_BASE_URL="http://localhost:3001"
